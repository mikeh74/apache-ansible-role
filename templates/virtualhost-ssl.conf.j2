<IfModule mod_ssl.c>
    <VirtualHost {{ vhost.listen_ip | default(apache_listen_ip) }}:{{ vhost.listen_port_ssl | default(apache_listen_port_ssl) }}>
        ServerName {{ vhost.server_name }}
        {% if vhost.server_aliases is defined %}
        {% for alias in vhost.server_aliases %}
        ServerAlias {{ alias }}
        {% endfor %}
        {% endif %}
        ServerAdmin {{ vhost.server_admin | default('webmaster@localhost') }}
        DocumentRoot {{ vhost.document_root }}

        # SSL Configuration
        SSLEngine on
        SSLProtocol {{ vhost.ssl_protocol | default(apache_ssl_protocol) }}
        SSLCipherSuite {{ vhost.ssl_cipher_suite | default(apache_ssl_cipher_suite) }}
        SSLHonorCipherOrder on
        SSLCompression off

        # SSL Certificates
        SSLCertificateFile {{ vhost.ssl_cert_path | default(ssl_cert_path) }}
        SSLCertificateKeyFile {{ vhost.ssl_key_path | default(ssl_key_file) }}
        {% if vhost.ssl_chain_file is defined or ssl_chain_file is defined %}
        SSLCertificateChainFile {{ vhost.ssl_chain_file | default(ssl_chain_file) }}
        {% endif %}

        # HSTS (HTTP Strict Transport Security)
        Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        
        # Security headers
        Header always set X-Content-Type-Options nosniff
        Header always set X-Frame-Options DENY
        Header always set X-XSS-Protection "1; mode=block"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"

        # Logging
        ErrorLog ${APACHE_LOG_DIR}/{{ vhost.name }}_ssl_error.log
        CustomLog ${APACHE_LOG_DIR}/{{ vhost.name }}_ssl_access.log combined

        # Directory configuration
        <Directory {{ vhost.document_root }}>
            Options {{ vhost.options | default('Indexes FollowSymLinks') }}
            AllowOverride {{ vhost.allow_override | default('All') }}
            Require all granted
            {% if vhost.extra_parameters is defined %}
            {{ vhost.extra_parameters | indent(12) }}
            {% endif %}
        </Directory>

        # SSL-specific directory settings
        <FilesMatch "\.(cgi|shtml|phtml|php)$">
            SSLOptions +StdEnvVars
        </FilesMatch>
        
        <Directory /usr/lib/cgi-bin>
            SSLOptions +StdEnvVars
        </Directory>

        {% if vhost.custom_log is defined %}
        CustomLog {{ vhost.custom_log }} {{ vhost.custom_log_format | default('combined') }}
        {% endif %}

        {% if vhost.extra_config is defined %}
        {{ vhost.extra_config | indent(8) }}
        {% endif %}
    </VirtualHost>
</IfModule>